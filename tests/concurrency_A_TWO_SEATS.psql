-- ==============================================================================
-- CINENOVA Phase 3 – Concurrency Scenario 2: Connection A (Hold D7 + D8)
-- File: tests/concurrency_A_TWO_SEATS.psql
--
-- Instructions for psql:
--   \set customer_a 'UUID_OF_CUSTOMER_A'
--   \i tests/concurrency_A_TWO_SEATS.psql
-- ==============================================================================

BEGIN;
SET LOCAL statement_timeout = '60s';
SET LOCAL ROLE authenticated;
SELECT set_config('request.jwt.claim.sub', :'customer_a', true);
SELECT set_config('request.jwt.claims', json_build_object('sub', :'customer_a', 'role', 'authenticated')::text, true);

SELECT public.acquire_seat_hold(
  'f3a00000-0000-4000-8000-000000000004'::uuid,
  ARRAY['f3a00000-0000-4000-8000-000000000007'::uuid, 'f3a00000-0000-4000-8000-000000000008'::uuid]
);

\echo '>>> [SESSION A] Acquired holds on D7 and D8.'
\echo '>>> TRANSACTION REMAINS UNCOMMITTED. Switch to Session B now and execute concurrency_B_TWO_SEATS.psql.'
\echo '>>> Return here and type: COMMIT;'

